{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ar1s Launcher",
  "version": "0.0.7-251",
  "identifier": "com.jdbewl.ar1s-launcher",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ar1s Launcher",
        "width":925,
        "height": 625,
        "minWidth": 500,
        "minHeight": 250,
        "userAgent": "Ar1s Launcher",
        "label": "main",
        "center": true,
        "decorations": false,
        "backgroundColor": "#141218"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' ipc: http://ipc.localhost ws:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "copyright": "Copyright (c) 2025-2026 JDBeWL",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
